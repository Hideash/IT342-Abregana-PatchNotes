<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvPatchIcon" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_bg" android:gravity="center" android:textSize="18sp" android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvPatchName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPatchDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvMemberCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="11sp"/>
    </LinearLayout>

    <Button android:id="@+id/btnJoin" android:layout_width="wrap_content" android:layout_height="32dp" android:text="+ Join" android:textColor="@color/white" android:textSize="12sp" android:background="@drawable/btn_accent"/>

</LinearLayout>