<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="10dp">

    <TextView android:id="@+id/tvCommentAvatar" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/icon_circle_bg" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginEnd="10dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/tvCommentUsername" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
        <TextView android:id="@+id/tvCommentContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvCommentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="10sp"/>
    </LinearLayout>

</LinearLayout>