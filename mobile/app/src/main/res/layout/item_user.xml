<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvUserAvatar" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/avatar_bg" android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvUserEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="11sp"/>
    </LinearLayout>

    <Button android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="32dp" android:text="+ Add" android:textColor="@color/white" android:textSize="12sp" android:background="@drawable/btn_accent"/>

</LinearLayout>