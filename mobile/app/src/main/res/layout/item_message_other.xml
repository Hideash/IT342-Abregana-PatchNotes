<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvMsgAvatar" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/icon_circle_bg" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="9sp" android:layout_gravity="bottom" android:layout_marginEnd="6dp"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvMsgContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bubble_other_bg" android:textColor="@color/white" android:textSize="13sp" android:padding="10dp" android:maxWidth="250dp"/>
        <TextView android:id="@+id/tvMsgTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="10sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

</LinearLayout>